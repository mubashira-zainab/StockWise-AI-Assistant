# ==========================================
# StockWise AI - Environment Configuration
# ==========================================

# GROQ_API_KEY: Required for intelligent Groq chat completions
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY="your_actual_groq_api_key_here"

# GROQ_MODEL: Default supported Groq AI model
# Recommended options:
# - llama-3.3-70b-versatile (Default: High reasoning, business analytics)
# - llama-3.1-8b-instant (Ultra-fast latency)
# - mixtral-8x7b-32768 (High context window)
# - gemma2-9b-it (Balanced)
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Fallback model key if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
